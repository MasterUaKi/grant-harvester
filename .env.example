# File: .env.example
# Version: 1.0.0 | Release Date: 2026-11-10
# EN: Environment variables template for grant-harvester. Copy to '.env' and fill values.
# DE: Vorlage für Umgebungsvariablen für grant-harvester. Nach '.env' kopieren und Werte eintragen.

# ==============================================================================
# LLM API CONFIGURATION / LLM-API-KONFIGURATION
# ==============================================================================
# EN: DeepSeek API access key / DE: DeepSeek API-Zugriffsschlüssel
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# EN: DeepSeek base endpoint / DE: DeepSeek Basis-Endpunkt
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# EN: Fast Tier-1 model for initial parsing / DE: Schnelles Stufe-1-Modell für Erstanalysen
PYCOGNITION_FAST_MODEL=deepseek-chat

# EN: Deep Tier-2 model for reflection & self-healing / DE: Tiefenreflexionsmodell (R1) für Selbstheilung
PYCOGNITION_REASONER_MODEL=deepseek-reasoner

# ==============================================================================
# HARVESTER RUNTIME LIMITS / HARVESTER-LAUFZEITGRENZWERTE
# ==============================================================================
# EN: Maximum depth for graph link traversal / DE: Maximale Tiefe der Link-Traversierung
MAX_CRAWL_DEPTH=6

# EN: Maximum reflection attempts per failing source / DE: Maximale Reflexionsversuche pro fehlerhafter Quelle
MAX_REFLECTION_ATTEMPTS=2

# EN: Maximum pages crawled per funding portal / DE: Maximale Seitenzahl pro Förderportal
MAX_PAGES_PER_SOURCE=10

# EN: Background daemon execution interval (in minutes) / DE: Daemon-Ausführungsintervall (in Minuten)
INTERVAL_MINUTES=60

# EN: Outbound HTTP request timeout (in seconds) / DE: Timeout für ausgehende HTTP-Anfragen (in Sekunden)
REQUEST_TIMEOUT_SEC=30.0

# ==============================================================================
# ARBITER & REPOSITORY PATHS / ARBITER- & VERZEICHNISPFADE
# ==============================================================================
# EN: MetaArbiter confidence threshold for procedural skills / DE: Konfidenzschwelle für prozedurale Skills
PYCOGNITION_ARBITER_THRESHOLD=0.55

# EN: Procedural skills storage directory / DE: Speicherverzeichnis für prozedurale Skills
PYCOGNITION_SKILLS_DIR=./skills_registry